---
import Base from '../../layouts/Base.astro';
import { STAGES } from '../../data/stages';
import { getSortedResources, resSlug } from '../../lib/resources';
import { url } from '../../lib/notes';
const resources = await getSortedResources();
const groups = [
  ...STAGES.map((s) => ({ title: `阶段 ${s.n} · ${s.name}`, items: resources.filter((r) => r.data.stage === s.n) })),
  { title: '未分阶段', items: resources.filter((r) => !STAGES.some((s) => s.n === r.data.stage)) },
].filter((g) => g.items.length);
---
<Base title="资源导读 · 学习笔记">
  <h1>资源导读</h1>
  <p class="en">Anthropic 笔记之外的外部课程与文章导读，按主阶段分组；它们在<a href={url('/path/')}>学习路线</a>里穿插出现。</p>
  {resources.length === 0 && <p class="empty">资源导读撰写中…</p>}
  {groups.map((g) => (
    <section class="module">
      <h2>{g.title}</h2>
      <ol class="route">
        {g.items.map((r) => (
          <li>
            {r.data.kind && <span class="badge">{r.data.kind}</span>}
            <a href={url(`resources/${resSlug(r)}/`)}>{r.data.title_zh}</a>
            {r.data.provider && <span class="meta" style="display:inline"> · {r.data.provider}</span>}
            {r.data.optional && <span class="badge">选读</span>}
            {r.data.status && r.data.status !== 'active' && <span class="badge">{r.data.status}</span>}
            {r.data.summary && <p class="sum" style="margin-left:0">{r.data.summary}</p>}
          </li>
        ))}
      </ol>
    </section>
  ))}
</Base>
