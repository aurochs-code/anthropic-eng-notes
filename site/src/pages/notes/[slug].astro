---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { MODULES } from '../../content.config';
import { getSortedNotes, fmtDate, url } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getSortedNotes();
  return notes.map((note, i) => ({
    params: { slug: note.data.slug },
    props: { note, prev: notes[i - 1], next: notes[i + 1] },
  }));
}
const { note, prev, next } = Astro.props;
const d = note.data;
const { Content } = await render(note);
---
<Base title={`${d.title_zh} · 学习笔记`} mermaid={true}>
  <article>
    <h1>{d.title_zh}</h1>
    <p class="en">{d.title_en}</p>
    <div class="meta">
      <span>#{d.order} · 模块 {d.moduleKey} {MODULES[d.moduleKey]}</span>
      <span>原文发布：{fmtDate(d.published)}</span>
      <span>阅读约 {d.reading_time} 分钟</span>
      <a href={d.source_url} target="_blank" rel="noopener">原文链接 ↗</a>
    </div>
    <ul class="tags">{d.tags.map((t) => <li>{t}</li>)}</ul>
    {d.source_note && <div class="note-box">⚠️ {d.source_note}</div>}
    <Content />
  </article>
  <nav class="pager">
    {prev ? <a class="prev" href={url(`notes/${prev.data.slug}/`)}><small>← 上一篇 #{prev.data.order}</small>{prev.data.title_zh}</a> : <span />}
    {next ? <a class="next" href={url(`notes/${next.data.slug}/`)}><small>下一篇 #{next.data.order} →</small>{next.data.title_zh}</a> : <span />}
  </nav>
</Base>
