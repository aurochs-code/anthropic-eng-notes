---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import RoutePager from '../../components/RoutePager.astro';
import TagList from '../../components/TagList.astro';
import Backlinks from '../../components/Backlinks.astro';
import { MODULES } from '../../content.config';
import { getSortedNotes, fmtDate, url } from '../../lib/notes';
import { getMainSequence } from '../../lib/resources';
import { stageName } from '../../data/stages';
import { splitSourceNote } from '../../lib/remark-plugins.mjs';

export async function getStaticPaths() {
  const notes = await getSortedNotes();
  return notes.map((note, i) => ({
    params: { slug: note.data.slug },
    props: { note, prev: notes[i - 1], next: notes[i + 1] },
  }));
}
const { note, prev, next } = Astro.props;
const d = note.data;
const { Content, headings } = await render(note);
const seq = await getMainSequence();
const at = seq.findIndex((s) => s.item.type === 'note' && s.item.note.data.slug === d.slug);
const me = seq[at];
const parts = d.source_note ? splitSourceNote(d.source_note) : null;
---
<Base title={`${d.title_zh} · 学习笔记`} description={d.summary} ogType="article" headings={headings} readProgress={true}>
  <article data-order={d.order}>
    <nav class="breadcrumb" aria-label="位置" data-pagefind-ignore>
      <a href={url('/')}>笔记</a><span aria-hidden="true">›</span><a href={url(`/#module-${d.moduleKey}`)}>模块 {d.moduleKey} · {MODULES[d.moduleKey]}</a>
      {me && <a class="crumb-step" href={url(`/path/#step-${me.n}`)} data-route-step={me.n}>阶段 {me.stage} · {stageName(me.stage)} · 第 {me.n} 步</a>}
    </nav>
    <h1>{d.title_zh}</h1>
    {d.title_en && <p class="en">{d.title_en}</p>}
    <div class="meta">
      <span>
        模块 {d.moduleKey} {MODULES[d.moduleKey]}
        {' · '}原文发布：{fmtDate(d.published)}
        {' · '}阅读约 {d.reading_time} 分钟
        {d.authors_en?.length ? ` · ${d.authors_en.join(', ')}` : ''}
        {' · '}<a href={d.source_url} target="_blank" rel="noopener">原文链接 ↗</a>
      </span>
    </div>
    {parts && (
      <details class="callout warn">
        <summary><span class="callout-title">⚠ 原文已更新</span> · {parts.lead}</summary>
        {parts.rest && <p>{parts.rest}</p>}
      </details>
    )}
    <Toc headings={headings} variant="inline" />
    <Content />
    <TagList tags={d.tags} />
    <div class="mark-read-row" data-pagefind-ignore>
      <button type="button" class="mark-read" data-pid={`n:${d.slug}`} aria-pressed="false"><span class="mark-label">标记为已读</span></button>
      <span class="meta" style="display:inline">进度只保存在本机浏览器，<a href={url(me ? `/path/#step-${me.n}` : '/path/')}>在学习路线中查看</a></span>
    </div>
  </article>
  <Backlinks slug={d.slug} />
  <nav class="pager" aria-label="按编号翻页" data-pager="order" data-pagefind-ignore>
    {prev ? <a class="prev" href={url(`notes/${prev.data.slug}/`)}><small>← 上一篇 #{prev.data.order}</small><span class="pager-title">{prev.data.title_zh}</span></a> : <span />}
    {next ? <a class="next" href={url(`notes/${next.data.slug}/`)}><small>下一篇 #{next.data.order} →</small><span class="pager-title">{next.data.title_zh}</span></a> : <span />}
  </nav>
  {me && <RoutePager seq={seq} at={at} />}
</Base>
