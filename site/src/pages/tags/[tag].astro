---
import Base from '../../layouts/Base.astro';
import { getTags } from '../../lib/tags';
import { url } from '../../lib/notes';
import { resSlug } from '../../lib/resources';
import { dd } from '../../lib/papers';
import { MODULES } from '../../content.config';

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map((t) => ({ params: { tag: t.slug }, props: { t } }));
}
const { t } = Astro.props;
---
<Base title={`标签：${t.tag} · 学习笔记`} description={`标签「${t.tag}」下的 ${t.notes.length} 篇笔记、${t.papers.length} 篇论文笔记、${t.resources.length} 个资源导读。`} searchable={false}>
  <nav class="breadcrumb" aria-label="位置"><a href={url('/tags/')}>标签</a><span aria-hidden="true">›</span><span>{t.tag}</span></nav>
  <h1>标签：{t.tag}</h1>
  <p class="lede">{t.notes.length} 篇笔记 · {t.papers.length} 篇论文笔记 · {t.resources.length} 个资源导读</p>
  {t.notes.length > 0 && (
    <section class="module" data-tag-notes={t.notes.length}>
      <h2>笔记（{t.notes.length}）</h2>
      <ol class="entry-list">
        {t.notes.map((n) => (
          <li class="entry entry-note">
            <div class="entry-line">
              <span class="entry-dot" aria-hidden="true"></span>
              <span class="entry-num">{String(n.data.order).padStart(2, '0')}</span>
              <a class="entry-title" href={url(`notes/${n.data.slug}/`)} data-note-link={n.data.slug}>{n.data.title_zh}</a>
              <span class="entry-time">{n.data.reading_time} 分钟</span>
            </div>
            <p class="entry-meta">模块 {n.data.moduleKey} {MODULES[n.data.moduleKey]}</p>
            <p class="entry-sum">{n.data.summary}</p>
          </li>
        ))}
      </ol>
    </section>
  )}
  {t.papers.length > 0 && (
    <section class="module" data-tag-papers={t.papers.length}>
      <h2>论文笔记（{t.papers.length}）</h2>
      <ol class="entry-list">
        {t.papers.map((p) => (
          <li class="entry">
            <div class="entry-line">
              <span class="entry-num">D{dd(p.data.day)}</span>
              <a class="entry-title" href={url(`papers/${p.data.slug}/`)} data-paper-link={p.data.slug}>{p.data.title_zh}</a>
            </div>
            <p class="entry-meta">{p.data.segment}</p>
            <p class="entry-sum">{p.data.summary}</p>
          </li>
        ))}
      </ol>
    </section>
  )}
  {t.resources.length > 0 && (
    <section class="module" data-tag-resources={t.resources.length}>
      <h2>资源导读（{t.resources.length}）</h2>
      <ol class="entry-list">
        {t.resources.map((r) => (
          <li class="entry entry-res">
            <div class="entry-line">
              <span class="res-kind">资源</span>
              <a class="entry-title" href={url(`resources/${resSlug(r)}/`)}>{r.data.title_zh}</a>
            </div>
            <p class="entry-sum">{r.data.summary}</p>
          </li>
        ))}
      </ol>
    </section>
  )}
  <p class="meta" style="margin-top:24px"><a href={url('/tags/')}>← 全部标签</a></p>
</Base>
