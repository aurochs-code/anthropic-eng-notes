---
import '../styles.css';
import { url } from '../lib/notes';
import Sidebar from '../components/Sidebar.astro';
import Toc, { type Heading } from '../components/Toc.astro';
const SITE_DESC = 'Anthropic 工程博客 26 篇文章的中文学习笔记（非翻译），附外部资源导读与 4 阶段学习路线。';
// searchable=false：不进搜索索引（首页、资源列表只是摘要汇总，会挤占真正的笔记结果）
// readProgress：页顶阅读进度条（笔记 / 资源页）
// noindex：加 <meta name="robots" content="noindex">（404 页）；具名插槽 head：页面在 <head> 最前面插入内联脚本
const { title, description = SITE_DESC, ogType = 'website', headings = [], searchable = true, readProgress = false, noindex = false } = Astro.props as {
  title: string; description?: string; ogType?: string; headings?: Heading[]; searchable?: boolean; readProgress?: boolean; noindex?: boolean;
};
const desc = description.replace(/\s+/g, ' ').trim();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const tocList = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const hasToc = tocList.length > 0;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <slot name="head" />
  <script is:inline>
    // 首屏前确定主题，避免闪烁：theme = auto | light | dark（localStorage），html[data-theme] 为实际生效的 light/dark
    (function () {
      var pref = 'auto';
      try { pref = localStorage.getItem('theme') || 'auto'; } catch (e) {}
      var dark = pref === 'dark' || (pref !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
      var h = document.documentElement;
      h.dataset.themePref = pref;
      h.dataset.theme = dark ? 'dark' : 'light';
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@600;700&family=Source+Serif+4:ital,wght@1,400&display=swap" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="zh_CN" />
  <meta property="og:site_name" content="Anthropic 工程博客 · 中文学习笔记" />
</head>
<body class={hasToc ? 'has-toc' : undefined}>
  <a class="skip-link" href="#main">跳到正文</a>
  {readProgress && <div class="read-progress" role="progressbar" aria-label="阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>}
  <header class="site">
    <button type="button" class="icon-btn menu-btn" aria-controls="sidebar" aria-expanded="false" aria-label="打开导航菜单">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <a class="brand" href={url('/')}><span class="brand-long">Anthropic 工程博客 · 中文学习笔记</span><span class="brand-short">Anthropic 工程笔记</span></a>
    <nav class="top" aria-label="主导航">
      {[['/', '笔记'], ['/path/', '学习路线'], ['/papers/', '论文'], ['/resources/', '资源'], ['/tags/', '标签']].map(([p, label]) => (
        <a href={url(p)} aria-current={Astro.url.pathname === url(p) || (p === '/papers/' && Astro.url.pathname.startsWith(url('/papers/'))) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <div class="header-tools">
      <button type="button" class="search-btn" aria-haspopup="dialog" aria-controls="search-dialog" aria-label="搜索（快捷键 Ctrl K 或 /）">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="search-label">搜索笔记与资源</span><kbd>Ctrl K</kbd>
      </button>
      <button type="button" class="icon-btn theme-btn" aria-label="切换主题（当前：跟随系统）" title="切换主题">
        <svg class="i-auto" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg>
        <svg class="i-light" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <svg class="i-dark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        <span class="theme-label">自动</span>
      </button>
    </div>
  </header>
  <dialog id="search-dialog" class="search-dialog" aria-label="站内搜索" data-state="idle">
    <div class="search-head">
      <input class="search-input" type="search" placeholder="搜索笔记与资源（中英文均可）" aria-label="搜索关键词" autocomplete="off" enterkeyhint="search" />
      <button type="button" class="icon-btn search-close" aria-label="关闭搜索">✕</button>
    </div>
    <p class="search-summary" role="status" aria-live="polite"></p>
    <ol class="search-results"></ol>
    <p class="search-foot" aria-hidden="true"><kbd>↑</kbd><kbd>↓</kbd> 选择　<kbd>Enter</kbd> 打开　<kbd>Esc</kbd> 关闭</p>
  </dialog>
  <div class="layout">
    <aside id="sidebar" class="sidebar" aria-label="导航侧栏">
      <Sidebar />
    </aside>
    <div class="sidebar-backdrop" hidden></div>
    <main id="main" data-pagefind-body={searchable ? '' : undefined}><slot /></main>
    {hasToc && <aside class="toc-col"><Toc headings={headings} variant="side" /></aside>}
  </div>
  <footer class="site">学习笔记，非翻译；原文版权归 Anthropic 所有。</footer>
  {hasToc && (
    <>
      <button type="button" class="toc-fab" aria-haspopup="dialog" aria-controls="toc-drawer">本页目录</button>
      <dialog id="toc-drawer" class="toc-drawer" aria-label="本页目录">
        <div class="drawer-head"><strong>本页目录</strong><button type="button" class="icon-btn drawer-close" aria-label="关闭目录">✕</button></div>
        <Toc headings={headings} variant="drawer" />
      </dialog>
    </>
  )}
  <button type="button" class="to-top" aria-label="回到顶部" title="回到顶部" hidden>↑</button>
  <script>
    import { initChrome } from '../lib/client/chrome';
    import { initSearch } from '../lib/client/search';
    import { initProgress } from '../lib/client/progress';
    initChrome();
    initSearch();
    initProgress();
    document.documentElement.dataset.js = 'ready'; // 供检查脚本确认每页都跑起了交互脚本
    // mermaid 按需加载：页面里有图才拉取（脚本必须只有这一个：Astro 不支持条件渲染的 <script>，
    // 写成 {cond && <script>} 时会把错误的脚本挂到页面上）
    if (document.querySelector('pre.mermaid')) import('../lib/client/mermaid').then((m) => m.initMermaid());
    // 动画（```anim / ```anim-steps）同理按需加载；没有动画的页面不请求任何动画脚本
    if (document.querySelector('figure.anim, figure[data-anim-steps]')) import('../lib/client/anim').then((m) => m.initAnim());
  </script>
</body>
</html>
