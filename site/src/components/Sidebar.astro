---
// 全局侧栏：学习路线、资源导读、A–F 模块分组的笔记；高亮当前页
import { MODULES } from '../content.config';
import { getSortedNotes, url } from '../lib/notes';
import { getSortedResources, resSlug } from '../lib/resources';
const here = Astro.url.pathname;
const notes = await getSortedNotes();
const resources = await getSortedResources();
const cur = (p: string) => (here === url(p) ? 'page' : undefined);
const groups = Object.entries(MODULES).map(([k, name]) => ({ k, name, items: notes.filter((n) => n.data.moduleKey === k) }));
const inRes = here.startsWith(url('/resources/'));
const curNote = notes.find((n) => here === url(`notes/${n.data.slug}/`));
// 笔记页只展开当前模块，其余页面全部展开
---
<nav class="sidebar-nav" aria-label="全站导航" data-pagefind-ignore>
  <ul class="side-top">
    <li><a href={url('/')} aria-current={cur('/')}>笔记目录</a></li>
    <li><a href={url('/path/')} aria-current={cur('/path/')}>学习路线</a></li>
    <li><a href={url('/resources/')} aria-current={cur('/resources/')}>资源导读</a></li>
    <li><a href={url('/tags/')} aria-current={here.startsWith(url('/tags/')) ? 'page' : undefined}>标签</a></li>
  </ul>
  {groups.map((g) => (
    <details class="side-group" open={!curNote || curNote.data.moduleKey === g.k} data-module={g.k}>
      <summary>{g.k} · {g.name}</summary>
      <ul>
        {g.items.map((n) => (
          <li><a href={url(`notes/${n.data.slug}/`)} aria-current={cur(`notes/${n.data.slug}/`)} data-note-link={n.data.slug}><span class="side-num">{String(n.data.order).padStart(2, '0')}</span>{n.data.title_zh}</a></li>
        ))}
      </ul>
    </details>
  ))}
  {resources.length > 0 && (
    <details class="side-group" open={inRes}>
      <summary>资源导读（{resources.length}）</summary>
      <ul>
        {resources.map((r) => (
          <li><a href={url(`resources/${resSlug(r)}/`)} aria-current={cur(`resources/${resSlug(r)}/`)}>{r.data.title_zh}</a></li>
        ))}
      </ul>
    </details>
  )}
</nav>
